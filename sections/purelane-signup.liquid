<section class="sec purelane-signup" data-section-id="{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2">{{ section.settings.heading }}</h2>
      <div class="lede">{{ section.settings.subheading }}</div>
      {% form 'customer', class: 'purelane-signup__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="purelane-signup__input"
          placeholder="{{ section.settings.placeholder }}"
          aria-label="Email address"
          required
        >
        <button type="submit" class="btn btn-primary">{{ section.settings.button_label }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Signup",
  "tag": "section",
  "class": "purelane-signup-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Plus first access to new launches and restocks.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my ₹100 off" }
  ],
  "presets": [{ "name": "Purelane Signup" }]
}
{% endschema %}
