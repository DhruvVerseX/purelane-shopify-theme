<section
  id="purelane-top"
  class="purelane-hero sec"
  data-section-id="{{ section.id }}"
  data-scene="1"
>
  <div class="purelane-hero__wrapper wrap">
    <div class="purelane-hero__grid">

      {%- if section.blocks.size > 0 -%}
        <div class="badges glass-2 rv in" aria-label="Product promises">
          {%- for block in section.blocks -%}
            {%- if block.type == 'promise' -%}
              <div class="badge" {{ block.shopify_attributes }}>
                <span class="bi">
                  {%- case block.settings.icon -%}
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                    {%- when 'ban' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                  {%- endcase -%}
                </span>
                <span>{{ block.settings.label | newline_to_br }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="purelane-hero__copy">
        {%- assign highlighted_word = section.settings.highlighted_word -%}
        {%- assign heading_parts = section.settings.heading | split: highlighted_word -%}
        <h1 class="purelane-hero__heading d1 rv in">
          {%- if heading_parts.size == 2 -%}
            {%- assign before_lines = heading_parts[0] | split: '/' -%}
            {%- for line in before_lines -%}
              {{ line | strip }}{% unless forloop.last %}<br>{% endunless %}
            {%- endfor -%}
            <span class="purelane-hero__highlight lime">{{ highlighted_word }}</span>
            {%- assign after_lines = heading_parts[1] | split: '/' -%}
            {%- for line in after_lines -%}
              {%- if line != blank -%}<br>{{ line | strip }}{%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign all_lines = section.settings.heading | split: '/' -%}
            {%- for line in all_lines -%}
              {{ line | strip }}{% unless forloop.last %}<br>{% endunless %}
            {%- endfor -%}
          {%- endif -%}
        </h1>

        <div class="rule rv rv-d1 in">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <i></i>
        </div>

        {%- if section.settings.description != blank -%}
          <p class="purelane-hero__description lede rv rv-d2 in">{{ section.settings.description }}</p>
        {%- endif -%}

        <div class="purelane-hero__cta rv rv-d3 in">
          {%- if section.settings.primary_button_label != blank -%}
            <a href="{{ section.settings.primary_button_link }}" class="btn btn-primary">
              {{ section.settings.primary_button_label }}
              {%- if section.settings.primary_button_show_arrow -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {%- endif -%}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_button_label != blank -%}
            <a href="{{ section.settings.secondary_button_link }}" class="btn btn-ghost">{{ section.settings.secondary_button_label }}</a>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="badgestrip rv rv-d4 in">
            {%- for block in section.blocks -%}
              {%- if block.type == 'promise' -%}
                <div class="glass-2">
                  {%- case block.settings.icon -%}
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                    {%- when 'ban' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                  {%- endcase -%}
                  {{ block.settings.short_label | default: block.settings.label | strip_html }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="purelane-hero__product-wrapper hero-prod" id="heroProd">
        <div class="hstage" id="hstage">
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'slide' -%}
              {%- assign slide_index = slide_index | plus: 1 -%}
              <div class="hslide hs{{ block.settings.product_count }} {% if slide_index == 1 %}on{% endif %}" data-n="{{ block.settings.product_count }}" {{ block.shopify_attributes }}>
                {%- assign bottle_variants = 'kitchen,tap,metal' | split: ',' -%}
                {%- for i in (1..block.settings.product_count) -%}
                  {%- assign product_key = 'product_' | append: i -%}
                  {%- assign slide_product = block.settings[product_key] -%}
                  {%- assign slot_class = 'a' -%}
                  {%- if i == 2 -%}{%- assign slot_class = 'b' -%}{%- endif -%}
                  {%- if i == 3 -%}{%- assign slot_class = 'c' -%}{%- endif -%}
                  <span class="hp {{ slot_class }} d{{ i }}">
                    {%- if slide_product != blank and slide_product.featured_image != blank -%}
                      {{ slide_product.featured_image | image_url: width: 600 | image_tag: loading: 'eager', alt: slide_product.title, class: 'purelane-hero__slide-img' }}
                    {%- else -%}
                      {%- assign variant_index = i | minus: 1 | modulo: 3 -%}
                      {%- capture bottle_uid -%}{{ block.id }}-{{ i }}{%- endcapture -%}
                      {%- render 'purelane-bottle', variant: bottle_variants[variant_index], uid: bottle_uid -%}
                    {%- endif -%}
                  </span>
                {%- endfor -%}
                <div class="glass-2 ptag">
                  <span class="lbl">{{ block.settings.price_label }}</span>
                  <span class="val">
                    <strong>{{ block.settings.price }}</strong>
                    {%- if block.settings.compare_price != blank -%}
                      <s>{{ block.settings.compare_price }}</s>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.savings_label != blank -%}
                    <span class="cut">{{ block.settings.savings_label }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="hdots" id="hdots">
          {%- assign dot_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'slide' -%}
              {%- assign dot_count = dot_count | plus: 1 -%}
              <button type="button" class="{% if dot_count == 1 %}on{% endif %}" aria-label="Show {{ block.settings.product_count }} product bundle"></button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean / That / Lasts"
    },
    {
      "type": "text",
      "id": "highlighted_word",
      "label": "Highlighted word",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "checkbox",
      "id": "primary_button_show_arrow",
      "label": "Show arrow on primary button",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise badge",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "ban", "label": "Ban" }
          ]
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "default": "Plant\npowered"
        },
        {
          "type": "text",
          "id": "short_label",
          "label": "Mobile label",
          "default": "Plant powered"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Hero product slide",
      "limit": 3,
      "settings": [
        {
          "type": "range",
          "id": "product_count",
          "label": "Products shown",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "Single bottle"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹200"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at price",
          "default": "₹299"
        },
        {
          "type": "text",
          "id": "savings_label",
          "label": "Savings label",
          "default": "33% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        { "type": "promise", "settings": { "icon": "leaf", "label": "Plant\npowered", "short_label": "Plant powered" } },
        { "type": "promise", "settings": { "icon": "shield", "label": "Safe for\nkids & pets", "short_label": "Kids & pet safe" } },
        { "type": "promise", "settings": { "icon": "ban", "label": "Zero harsh\nchemicals", "short_label": "Zero harsh chem" } },
        { "type": "slide", "settings": { "product_count": 1, "price_label": "Single bottle", "price": "₹200", "compare_price": "₹299", "savings_label": "33% off" } },
        { "type": "slide", "settings": { "product_count": 2, "price_label": "Any 2 products", "price": "₹349", "compare_price": "₹598", "savings_label": "Save ₹249" } },
        { "type": "slide", "settings": { "product_count": 3, "price_label": "Any 3 products", "price": "₹499", "compare_price": "₹897", "savings_label": "Save ₹398" } }
      ]
    }
  ]
}
{% endschema %}
