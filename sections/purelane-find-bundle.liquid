<!-- ================= FIND THE RIGHT BUNDLE ================= -->
<section
  class="sec"
  id="purelane-categories-{{ section.id }}"
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="find-bundle"
  data-purelane-anchor="categories"
  data-scene="4"
>
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bundle categories' | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Find the right bundle for you' | escape }}</h2>
    </div>
    <div class="cats"><a class="glass cat rv" href="{{ section.settings.category_link | default: '#combos' }}"><span class="ph"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span></span><span class="txt"><h4>{{ section.settings.category_1_title | default: 'Kitchen bundle' | escape }}</h4><p>{{ section.settings.category_1_body | default: 'Grease, dishes & more' | escape }}</p></span></a><a class="glass cat rv rv-d1" href="{{ section.settings.category_link | default: '#combos' }}"><span class="ph"><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span></span><span class="txt"><h4>{{ section.settings.category_2_title | default: 'Bathroom bundle' | escape }}</h4><p>{{ section.settings.category_2_body | default: 'Deep clean & disinfect' | escape }}</p></span></a><a class="glass cat rv rv-d2" href="{{ section.settings.category_link | default: '#combos' }}"><span class="ph"><span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span></span><span class="txt"><h4>{{ section.settings.category_3_title | default: 'Laundry bundle' | escape }}</h4><p>{{ section.settings.category_3_body | default: 'Softer, fresher wash' | escape }}</p></span></a><a class="glass cat rv rv-d3" href="{{ section.settings.category_link | default: '#combos' }}"><span class="ph"><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span></span><span class="txt"><h4>{{ section.settings.category_4_title | default: 'Hard water bundle' | escape }}</h4><p>{{ section.settings.category_4_body | default: 'Melt away limescale' | escape }}</p></span></a></div>
  </div>
</section>
{% schema %}
{
  "name": "Purelane Categories",
  "tag": "section",
  "class": "purelane-categories-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right bundle for you" },
    { "type": "url", "id": "category_link", "label": "Category card link" },
    { "type": "text", "id": "category_1_title", "label": "Category 1 title", "default": "Kitchen bundle" },
    { "type": "text", "id": "category_1_body", "label": "Category 1 body", "default": "Grease, dishes & more" },
    { "type": "text", "id": "category_2_title", "label": "Category 2 title", "default": "Bathroom bundle" },
    { "type": "text", "id": "category_2_body", "label": "Category 2 body", "default": "Deep clean & disinfect" },
    { "type": "text", "id": "category_3_title", "label": "Category 3 title", "default": "Laundry bundle" },
    { "type": "text", "id": "category_3_body", "label": "Category 3 body", "default": "Softer, fresher wash" },
    { "type": "text", "id": "category_4_title", "label": "Category 4 title", "default": "Hard water bundle" },
    { "type": "text", "id": "category_4_body", "label": "Category 4 body", "default": "Melt away limescale" }
  ],
  "presets": [{ "name": "Purelane Categories" }]
}
{% endschema %}
