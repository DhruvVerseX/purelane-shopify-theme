{%- liquid
  assign card_product = product
  if card_product == blank
    assign card_product = product_ref
  endif
  assign selected_variant = card_product.selected_or_first_available_variant
  assign card_badge = badge
  if card_badge == blank and card_product.metafields.custom.badge != blank
    assign card_badge = card_product.metafields.custom.badge.value
  endif
  assign card_rating = rating
  if card_rating == blank and card_product.metafields.custom.rating != blank
    assign card_rating = card_product.metafields.custom.rating.value
  endif
  assign card_review_count = review_count
  if card_review_count == blank and card_product.metafields.custom.review_count != blank
    assign card_review_count = card_product.metafields.custom.review_count.value
  endif
  assign delay_class = delay_class | default: ''
  assign card_loading = loading | default: 'lazy'
  assign card_image_alt = card_product.featured_image.alt | default: card_product.title
-%}

{%- if card_product != blank -%}
<article
  class="glass card purelane-product-card rv {{ delay_class }}"
  {% if block != blank %}
    {{ block.shopify_attributes }}
    data-block-id="{{ block.id }}"
  {% elsif block_attributes %}
    {{ block_attributes }}
  {% endif %}
>
  <div class="shot">
    {%- if card_badge != blank -%}
      <span class="pill">{{ card_badge }}</span>
    {%- endif -%}
    <a href="{{ card_product.url }}" class="purelane-product-card__link">
      {%- if card_product.featured_image != blank -%}
        {{
          card_product.featured_image
          | image_url: width: 520
          | image_tag:
            loading: card_loading,
            widths: '180, 260, 360, 520',
            sizes: '(min-width: 990px) 260px, (min-width: 750px) 45vw, 82vw',
            alt: card_image_alt,
            class: 'purelane-product-card__img'
        }}
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>
  <h4><a href="{{ card_product.url }}">{{ card_product.title }}</a></h4>
  {%- if card_rating != blank or card_review_count != blank -%}
    <div class="rate">
      {%- if card_rating != blank -%}<b>&#9733; {{ card_rating }}</b>{%- endif -%}
      {%- if card_review_count != blank -%}
        {%- if card_rating != blank -%} &middot; {%- endif -%}{{ card_review_count }} reviews
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="pr" aria-live="polite">
    <strong>{{ selected_variant.price | money }}</strong>
    {%- if selected_variant.compare_at_price > selected_variant.price -%}
      <s>{{ selected_variant.compare_at_price | money }}</s>
      {%- assign savings = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price | round -%}
      <em>{{ savings }}% off</em>
    {%- endif -%}
  </div>
  <product-form class="purelane-product-card__form product-form" data-section-id="{{ section.id | default: '' }}">
    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <span class="product-form__error-message"></span>
    </div>
    {%- form 'product', card_product, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        value="{{ selected_variant.id }}"
        class="product-variant-id"
        {% unless selected_variant.available %}disabled{% endunless %}
      >
      <button type="submit" class="btn btn-ghost btn-sm" name="add" {% unless selected_variant.available %}disabled{% endunless %}>
        <span>
          {%- if selected_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
        {%- render 'loading-spinner' -%}
      </button>
    {%- endform -%}
  </product-form>
</article>
{%- endif -%}
