{% schema %}
{
  "name": "t:sections.purelane-find-bundle.name",
  "tag": "section",
  "class": "purelane-find-bundle-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.purelane-find-bundle.settings.header.content",
      "info": "t:sections.purelane-find-bundle.settings.header.info"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Find the right bundle for you",
      "label": "t:sections.purelane-find-bundle.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Grease, dishes &amp; more</p><p>Deep clean &amp; disinfect</p><p>Softer, fresher wash</p><p>Melt away limescale</p>",
      "label": "t:sections.purelane-find-bundle.settings.subheading.label"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.purelane-find-bundle.blocks.category.name",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.purelane-find-bundle.blocks.category.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.purelane-find-bundle.blocks.category.settings.link.label"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Kitchen bundle",
          "label": "t:sections.purelane-find-bundle.blocks.category.settings.heading.label"
        },
        {
          "type": "textarea",
          "id": "body",
          "default": "Grease, dishes &amp; more",
          "label": "t:sections.purelane-find-bundle.blocks.category.settings.body.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.purelane-find-bundle.presets.name",
      "category": "t:sections.purelane-find-bundle.presets.category",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
{% stylesheet %}
{% endstylesheet %}
{% javascript %}
{% endjavascript %}
<div class="purelane-find-bundle page-width">
  <div class="purelane-find-bundle__wrapper">
    {% if section.settings.heading != blank %}
    <div class="purelane-find-bundle__header">
      <span class="purelane-find-bundle__kicker">Bundle categories</span>
      <h2 class="purelane-find-bundle__heading">{{ section.settings.heading }}</h2>
      {{ section.settings.subheading }}
    </div>
    {% endif %}
    <div class="purelane-find-bundle__grid cats">
      {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="purelane-find-bundle__item glass cat">
        <span class="purelane-find-bundle__item-ph ph">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 100 | image_tag: width: 100, height: 100, alt: block.settings.heading }}
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
          {% endif %}
        </span>
        <span class="purelane-find-bundle__item-txt txt">
          <h4 class="purelane-find-bundle__item-heading">{{ block.settings.heading }}</h4>
          <p class="purelane-find-bundle__item-body">{{ block.settings.body }}</p>
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
