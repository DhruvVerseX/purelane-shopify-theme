<!-- ================= FOOTER ================= -->
<footer
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="footer"
  data-scene="4"
>
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="{{ section.settings.brand_link | default: '#top' }}" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg>
          </span>
          <span class="txt">
            <span class="n1">{{ section.settings.brand_name | default: 'Purelane' | escape }}</span>
            <span class="n2">{{ section.settings.tagline | default: 'Clean, simply' | escape }}</span>
          </span>
        </a>
        <p style="max-width:30ch">{{ section.settings.description | default: 'Effective cleaning, powered by nature. Made for Indian homes since day one.' | escape }}</p>
      </div>
      <div class="fcol">
        <h5>{{ section.settings.shop_heading | default: 'Shop' | escape }}</h5>
        <a href="{{ section.settings.shop_link_1_url | default: '#shop' }}">{{ section.settings.shop_link_1_label | default: 'Bestsellers' | escape }}</a>
        <a href="{{ section.settings.shop_link_2_url | default: '#shop' }}">{{ section.settings.shop_link_2_label | default: 'Kitchen' | escape }}</a>
        <a href="{{ section.settings.shop_link_3_url | default: '#shop' }}">{{ section.settings.shop_link_3_label | default: 'Laundry' | escape }}</a>
        <a href="{{ section.settings.shop_link_4_url | default: '#shop' }}">{{ section.settings.shop_link_4_label | default: 'Home' | escape }}</a>
        <a href="{{ section.settings.shop_link_5_url | default: '#shop' }}">{{ section.settings.shop_link_5_label | default: 'Skin' | escape }}</a>
        <a href="{{ section.settings.shop_link_6_url | default: '#bundles' }}">{{ section.settings.shop_link_6_label | default: 'Starter kits' | escape }}</a>
      </div>
      <div class="fcol">
        <h5>{{ section.settings.about_heading | default: 'About' | escape }}</h5>
        <a href="{{ section.settings.about_link_1_url | default: '#how' }}">{{ section.settings.about_link_1_label | default: 'How it works' | escape }}</a>
        <a href="{{ section.settings.about_link_2_url | default: '#ingredients' }}">{{ section.settings.about_link_2_label | default: 'Sustainability' | escape }}</a>
        <a href="{{ section.settings.about_link_3_url | default: '#proof' }}">{{ section.settings.about_link_3_label | default: 'FAQs' | escape }}</a>
        <a href="{{ section.settings.about_link_4_url | default: '#reviews' }}">{{ section.settings.about_link_4_label | default: 'Reviews' | escape }}</a>
      </div>
      <div class="fcol">
        <h5>{{ section.settings.contact_heading | default: 'Get in touch' | escape }}</h5>
        <a href="mailto:{{ section.settings.email | default: 'hello@purelane.com' }}">{{ section.settings.email | default: 'hello@purelane.com' | escape }}</a>
        <a href="tel:{{ section.settings.phone_href | default: '+919930123234' }}">{{ section.settings.phone_label | default: '+91 9930 123 234' | escape }}</a>
        <p style="font-size:12px;color:rgba(236,230,247,.5)">{{ section.settings.company_name | default: 'Purelane Eco Products Pvt Ltd' | escape }}</p>
      </div>
    </div>
    <div class="fbot">
      <span>{{ section.settings.copyright | default: '© 2026 Purelane Eco Products Private Limited' | escape }}</span>
      <span>{{ section.settings.legal_text | default: 'Privacy · Terms · Refunds · Contact' | escape }}</span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Purelane Footer",
  "tag": "section",
  "class": "purelane-footer-section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Purelane" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Clean, simply" },
    { "type": "url", "id": "brand_link", "label": "Brand link" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Effective cleaning, powered by nature. Made for Indian homes since day one." },
    { "type": "text", "id": "shop_heading", "label": "Shop heading", "default": "Shop" },
    { "type": "text", "id": "shop_link_1_label", "label": "Shop link 1 label", "default": "Bestsellers" },
    { "type": "url", "id": "shop_link_1_url", "label": "Shop link 1 URL" },
    { "type": "text", "id": "shop_link_2_label", "label": "Shop link 2 label", "default": "Kitchen" },
    { "type": "url", "id": "shop_link_2_url", "label": "Shop link 2 URL" },
    { "type": "text", "id": "shop_link_3_label", "label": "Shop link 3 label", "default": "Laundry" },
    { "type": "url", "id": "shop_link_3_url", "label": "Shop link 3 URL" },
    { "type": "text", "id": "shop_link_4_label", "label": "Shop link 4 label", "default": "Home" },
    { "type": "url", "id": "shop_link_4_url", "label": "Shop link 4 URL" },
    { "type": "text", "id": "shop_link_5_label", "label": "Shop link 5 label", "default": "Skin" },
    { "type": "url", "id": "shop_link_5_url", "label": "Shop link 5 URL" },
    { "type": "text", "id": "shop_link_6_label", "label": "Shop link 6 label", "default": "Starter kits" },
    { "type": "url", "id": "shop_link_6_url", "label": "Shop link 6 URL" },
    { "type": "text", "id": "about_heading", "label": "About heading", "default": "About" },
    { "type": "text", "id": "about_link_1_label", "label": "About link 1 label", "default": "How it works" },
    { "type": "url", "id": "about_link_1_url", "label": "About link 1 URL" },
    { "type": "text", "id": "about_link_2_label", "label": "About link 2 label", "default": "Sustainability" },
    { "type": "url", "id": "about_link_2_url", "label": "About link 2 URL" },
    { "type": "text", "id": "about_link_3_label", "label": "About link 3 label", "default": "FAQs" },
    { "type": "url", "id": "about_link_3_url", "label": "About link 3 URL" },
    { "type": "text", "id": "about_link_4_label", "label": "About link 4 label", "default": "Reviews" },
    { "type": "url", "id": "about_link_4_url", "label": "About link 4 URL" },
    { "type": "text", "id": "contact_heading", "label": "Contact heading", "default": "Get in touch" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@purelane.com" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "+91 9930 123 234" },
    { "type": "text", "id": "phone_href", "label": "Phone link value", "default": "+919930123234" },
    { "type": "text", "id": "company_name", "label": "Company name", "default": "Purelane Eco Products Pvt Ltd" },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "© 2026 Purelane Eco Products Private Limited" },
    { "type": "text", "id": "legal_text", "label": "Legal text", "default": "Privacy · Terms · Refunds · Contact" }
  ],
  "presets": [{ "name": "Purelane Footer" }]
}
{% endschema %}
