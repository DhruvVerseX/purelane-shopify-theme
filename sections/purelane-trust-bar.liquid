<section class="sec purelane-trust-bar" data-section-id="{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="glass trust rv">
      {%- for block in section.blocks -%}
        <div class="trust-i" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 52 | image_tag: loading: 'lazy', alt: block.settings.label, width: 26, height: 26 }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          {%- endif -%}
          <span>{{ block.settings.label | newline_to_br }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Trust Bar",
  "tag": "section",
  "class": "purelane-trust-bar-section",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon" },
        { "type": "textarea", "id": "label", "label": "Label", "default": "Plant derived\nformulas" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Trust Bar", "blocks": [{ "type": "trust_item" }, { "type": "trust_item" }, { "type": "trust_item" }, { "type": "trust_item" }] }]
}
{% endschema %}
