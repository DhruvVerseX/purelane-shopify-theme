<section id="bundles" class="sec purelane-bundles" data-section-id="{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.description }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier {% if block.settings.featured %}best{% endif %} rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.tag }}</span>
          <div class="tierpix {% if block.settings.product_count == '5' %}five{% endif %}" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- assign product_key = 'product_' | append: i -%}
              {%- assign tier_product = block.settings[product_key] -%}
              {%- if tier_product != blank -%}
                <span class="pimg">{{ tier_product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: tier_product.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="qty">{{ block.settings.product_count }}<small>Products</small></div>
          <div class="price">{{ block.settings.price }} {%- if block.settings.compare_price != blank -%}<s>{{ block.settings.compare_price }}</s>{%- endif -%}</div>
          <p class="body-s" style="font-size:12px">{{ block.settings.per_product_note }}</p>
          <ul>
            {%- for i in (1..3) -%}
              {%- assign feature_key = 'feature_' | append: i -%}
              {%- if block.settings[feature_key] != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ block.settings[feature_key] }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <a href="{{ block.settings.link | default: '#shop' }}" class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}">
            {{ block.settings.button_label | default: 'Build this box' }}
            {%- if block.settings.featured -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "limit": 3,
      "settings": [
        { "type": "checkbox", "id": "featured", "label": "Featured tier", "default": false },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "text", "id": "product_count", "label": "Product count", "default": "2" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹349" },
        { "type": "text", "id": "compare_price", "label": "Compare price", "default": "₹598" },
        { "type": "text", "id": "per_product_note", "label": "Per product note", "default": "Flat ₹174 per product" },
        { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Pick any two products" },
        { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Free shipping across India" },
        { "type": "text", "id": "feature_3", "label": "Feature 3" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Build this box" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "product", "id": "product_1", "label": "Preview product 1" },
        { "type": "product", "id": "product_2", "label": "Preview product 2" },
        { "type": "product", "id": "product_3", "label": "Preview product 3" },
        { "type": "product", "id": "product_4", "label": "Preview product 4" },
        { "type": "product", "id": "product_5", "label": "Preview product 5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "product_count": "2", "price": "₹349", "compare_price": "₹598", "per_product_note": "Flat ₹174 per product" } },
        { "type": "tier", "settings": { "featured": true, "tag": "Most popular", "product_count": "3", "price": "₹499", "compare_price": "₹897", "per_product_note": "Flat ₹166 per product", "feature_3": "Covers kitchen and laundry" } },
        { "type": "tier", "settings": { "tag": "Whole home", "product_count": "5", "price": "₹799", "compare_price": "₹1,495", "per_product_note": "Flat ₹160 per product", "feature_1": "Pick any five products", "feature_2": "Every room in one order", "feature_3": "Free shipping across India" } }
      ]
    }
  ]
}
{% endschema %}
