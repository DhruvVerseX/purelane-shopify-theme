<section id="how" class="sec purelane-how-it-works" data-section-id="{{ section.id }}" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      {%- for block in section.blocks -%}
        <article class="glass pillar rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}" {{ block.shopify_attributes }}>
          <span class="pi">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 50 | image_tag: loading: 'lazy', alt: block.settings.heading, width: 24, height: 24 }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
            {%- endif -%}
          </span>
          <h3 class="d3">{{ block.settings.heading }}</h3>
          <p class="body-s">{{ block.settings.body }}</p>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="btn btn-ghost btn-sm">Learn more</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane How It Works",
  "tag": "section",
  "class": "purelane-how-it-works-section",
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Less scrubbing" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane How It Works", "blocks": [{ "type": "pillar" }, { "type": "pillar" }, { "type": "pillar" }] }]
}
{% endschema %}
