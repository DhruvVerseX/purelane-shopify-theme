<!-- ================= PROOF ================= -->
<section
  class="sec"
  id="purelane-proof-{{ section.id }}"
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="proof"
  data-purelane-anchor="proof"
  data-scene="3"
>
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker | default: 'Why it works' | escape }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Tough on grime.<br>Gentle on everything else.' }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.body | default: 'Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for.' | escape }}</p>
          <a class="btn btn-primary" href="{{ section.settings.button_link | default: '#ingredients' }}">{{ section.settings.button_label | default: 'See the ingredient list' | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </div>
        <div class="glass-2 rot" aria-hidden="true" data-purelane-rotator><div class="frame"><span class="pimg p-kitchen on" role="img" aria-label="Purelane foaming kitchen cleaner" data-name="{{ section.settings.rotator_1_name | default: 'Kitchen cleaner' | escape }}" data-note="{{ section.settings.rotator_1_note | default: 'Foam lifts grease, no scrubbing' | escape }}"></span><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover" data-name="{{ section.settings.rotator_2_name | default: 'Tap & limescale' | escape }}" data-note="{{ section.settings.rotator_2_note | default: 'Melts hard water stains' | escape }}"></span><span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent" data-name="{{ section.settings.rotator_3_name | default: 'Laundry detergent' | escape }}" data-note="{{ section.settings.rotator_3_note | default: 'Tough on odour, soft on fabric' | escape }}"></span><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner" data-name="{{ section.settings.rotator_4_name | default: 'Toilet cleaner' | escape }}" data-note="{{ section.settings.rotator_4_note | default: 'Kills 99.9% of germs' | escape }}"></span><span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner" data-name="{{ section.settings.rotator_5_name | default: 'Floor cleaner' | escape }}" data-note="{{ section.settings.rotator_5_note | default: 'Neem powered, pet safe' | escape }}"></span><span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel" data-name="{{ section.settings.rotator_6_name | default: 'Dishwash gel' | escape }}" data-note="{{ section.settings.rotator_6_note | default: 'Cuts grease, kind to hands' | escape }}"></span></div><div class="cap"><b>{{ section.settings.rotator_1_name | default: 'Kitchen cleaner' | escape }}</b><span>{{ section.settings.rotator_1_note | default: 'Foam lifts grease, no scrubbing' | escape }}</span></div><div class="dots"><i class="on"></i><i></i><i></i><i></i><i></i><i></i></div></div>
        <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
          <div class="stat">
            <div class="ring">{{ section.settings.stat_1_value | default: '99.9%' | escape }}</div>
            <h5>{{ section.settings.stat_1_heading | default: 'Germ kill' | escape }}</h5>
            <p>{{ section.settings.stat_1_body | default: 'Tested against germs and bacteria' | escape }}</p>
          </div>
          <div class="stat">
            <div class="ring">{{ section.settings.stat_2_value | default: '0%' | escape }}</div>
            <h5>{{ section.settings.stat_2_heading | default: 'Sulphates' | escape }}</h5>
            <p>{{ section.settings.stat_2_body | default: 'No SLS, chlorine or parabens' | escape }}</p>
          </div>
          <div class="stat">
            <div class="ring">{{ section.settings.stat_3_value | default: '100%' | escape }}</div>
            <h5>{{ section.settings.stat_3_heading | default: 'Plant based' | escape }}</h5>
            <p>{{ section.settings.stat_3_body | default: 'Cleansers derived from plants' | escape }}</p>
          </div>
          <div class="stat">
            <div class="ring">{{ section.settings.stat_4_value | default: '4.8' | escape }}</div>
            <h5>{{ section.settings.stat_4_heading | default: 'Rated' | escape }}</h5>
            <p>{{ section.settings.stat_4_body | default: 'Across 8,000+ verified reviews' | escape }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Purelane Proof",
  "tag": "section",
  "class": "purelane-proof-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why it works" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Tough on grime.<br>Gentle on everything else." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the ingredient list" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Rotator captions" },
    { "type": "text", "id": "rotator_1_name", "label": "Item 1 name", "default": "Kitchen cleaner" },
    { "type": "text", "id": "rotator_1_note", "label": "Item 1 note", "default": "Foam lifts grease, no scrubbing" },
    { "type": "text", "id": "rotator_2_name", "label": "Item 2 name", "default": "Tap & limescale" },
    { "type": "text", "id": "rotator_2_note", "label": "Item 2 note", "default": "Melts hard water stains" },
    { "type": "text", "id": "rotator_3_name", "label": "Item 3 name", "default": "Laundry detergent" },
    { "type": "text", "id": "rotator_3_note", "label": "Item 3 note", "default": "Tough on odour, soft on fabric" },
    { "type": "text", "id": "rotator_4_name", "label": "Item 4 name", "default": "Toilet cleaner" },
    { "type": "text", "id": "rotator_4_note", "label": "Item 4 note", "default": "Kills 99.9% of germs" },
    { "type": "text", "id": "rotator_5_name", "label": "Item 5 name", "default": "Floor cleaner" },
    { "type": "text", "id": "rotator_5_note", "label": "Item 5 note", "default": "Neem powered, pet safe" },
    { "type": "text", "id": "rotator_6_name", "label": "Item 6 name", "default": "Dishwash gel" },
    { "type": "text", "id": "rotator_6_note", "label": "Item 6 note", "default": "Cuts grease, kind to hands" },
    { "type": "header", "content": "Stats" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "99.9%" },
    { "type": "text", "id": "stat_1_heading", "label": "Stat 1 heading", "default": "Germ kill" },
    { "type": "text", "id": "stat_1_body", "label": "Stat 1 body", "default": "Tested against germs and bacteria" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "0%" },
    { "type": "text", "id": "stat_2_heading", "label": "Stat 2 heading", "default": "Sulphates" },
    { "type": "text", "id": "stat_2_body", "label": "Stat 2 body", "default": "No SLS, chlorine or parabens" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "100%" },
    { "type": "text", "id": "stat_3_heading", "label": "Stat 3 heading", "default": "Plant based" },
    { "type": "text", "id": "stat_3_body", "label": "Stat 3 body", "default": "Cleansers derived from plants" },
    { "type": "text", "id": "stat_4_value", "label": "Stat 4 value", "default": "4.8" },
    { "type": "text", "id": "stat_4_heading", "label": "Stat 4 heading", "default": "Rated" },
    { "type": "text", "id": "stat_4_body", "label": "Stat 4 body", "default": "Across 8,000+ verified reviews" }
  ],
  "presets": [{ "name": "Purelane Proof" }]
}
{% endschema %}
