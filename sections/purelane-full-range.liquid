{%- assign collection = section.settings.collection -%}
{%- assign products_to_show = section.settings.products_to_show | plus: 0 -%}

<section id="range" class="sec purelane-full-range" data-section-id="{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading }}</h2>
        </div>
        <div class="body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.subheading | strip_html }}</div>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          {%- if collection != blank -%}
            {%- for product in collection.products limit: products_to_show -%}
              <span class="pimg" role="img" aria-label="{{ product.title | escape }}">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: product.title }}
                {%- endif -%}
              </span>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..10) -%}
              <span class="pimg" role="img" aria-label="Product placeholder">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</span>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <p class="striphint">Swipe to see the full shelf</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Full Range",
  "tag": "section",
  "class": "purelane-full-range-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The full range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every room, one shelf" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 14, "step": 1, "default": 10, "label": "Products to show" }
  ],
  "presets": [{ "name": "Purelane Full Range" }]
}
{% endschema %}
