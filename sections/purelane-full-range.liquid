<!-- ================= FULL RANGE ================= -->
<section
  class="sec"
  id="purelane-range-{{ section.id }}"
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="full-range"
  data-purelane-anchor="range"
  data-scene="3"
>
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker | default: 'The full range' | escape }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading | default: 'Every room, one shelf' | escape }}</h2>
        </div>
        <p class="body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.body | default: 'Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.' | escape }}</p>
      </div>
      <div class="stripwrap"><div class="rangerow"><span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner"></span><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span><span class="pimg p-laundry" role="img" aria-label="Purelane natural laundry detergent"></span><span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span><span class="pimg p-metal" role="img" aria-label="Purelane copper, bronze and brass cleaner"></span><span class="pimg p-wm" role="img" aria-label="Purelane washing machine cleaner and descaler"></span><span class="pimg p-handwash" role="img" aria-label="Purelane gentle hydrating liquid handwash"></span><span class="pimg p-eraser" role="img" aria-label="Purelane magic eraser"></span></div></div>
      <p class="striphint">{{ section.settings.hint | default: 'Swipe to see the full shelf' | escape }}</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Purelane Full Range",
  "tag": "section",
  "class": "purelane-range-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The full range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every room, one shelf" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink." },
    { "type": "text", "id": "hint", "label": "Swipe hint", "default": "Swipe to see the full shelf" }
  ],
  "presets": [{ "name": "Purelane Full Range" }]
}
{% endschema %}
