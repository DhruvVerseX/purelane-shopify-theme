<!-- ================= SHOP ================= -->
<section
  class="sec"
  id="purelane-shop-{{ section.id }}"
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="shop"
  data-purelane-anchor="shop"
  data-scene="3"
>
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bestsellers' | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Loved by 30,000 homes' | escape }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- liquid
              assign delay_index = forloop.index0 | modulo: 4
              assign delay_class = ''
              if delay_index > 0
                assign delay_class = 'rv-d' | append: delay_index
              endif
            -%}
            {%- render 'purelane-product-card',
              product: block.settings.product,
              badge: block.settings.badge,
              rating: block.settings.rating,
              review_count: block.settings.review_count,
              delay_class: delay_class,
              block: block
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collections.all.products limit: section.settings.products_to_show -%}
          {%- liquid
            assign delay_index = forloop.index0 | modulo: 4
            assign delay_class = ''
            if delay_index > 0
              assign delay_class = 'rv-d' | append: delay_index
            endif
          -%}
          {%- render 'purelane-product-card', product: product, delay_class: delay_class -%}
        {%- else -%}
          <p class="rv">{{ section.settings.empty_message | escape }}</p>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "purelane-shop-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "range", "id": "products_to_show", "label": "Products to show when no product blocks are added", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "empty_message", "label": "Empty catalog message", "default": "Add products to your catalog or select products in this section." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "rating", "label": "Rating" },
        { "type": "text", "id": "review_count", "label": "Review count" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Shop" }]
}
{% endschema %}
