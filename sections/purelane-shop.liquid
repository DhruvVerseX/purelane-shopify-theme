{%- assign collection = section.settings.collection -%}
{%- assign products_to_show = section.settings.products_to_show | plus: 0 -%}

<section id="shop" class="sec purelane-shop" data-section-id="{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule"><i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          {%- render 'purelane-product-card', product: product, badge: section.settings.default_badge, rating: section.settings.default_rating -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- render 'purelane-product-card',
              product: block.settings.product,
              badge: block.settings.badge,
              rating: block.settings.rating,
              review_count: block.settings.review_count,
              block_attributes: block.shopify_attributes
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "default": 4, "label": "Products to show" },
    { "type": "text", "id": "default_badge", "label": "Default badge", "default": "Best seller" },
    { "type": "text", "id": "default_rating", "label": "Default rating", "default": "4.8" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Best seller" },
        { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
        { "type": "text", "id": "review_count", "label": "Review count", "default": "237" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Shop", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
