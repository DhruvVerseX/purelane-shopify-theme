{%- liquid
  assign bottle_variant = variant | default: 'kitchen'
  assign bottle_uid = uid | default: bottle_variant
-%}
<span class="purelane-bottle purelane-bottle--{{ bottle_variant }}" aria-hidden="true">
  <svg viewBox="0 0 130 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Purelane product bottle">
    <defs>
      <linearGradient id="pl-bottle-{{ bottle_uid }}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#04756e"/>
        <stop offset=".55" stop-color="#4b3a8f"/>
        <stop offset="1" stop-color="#013f3d"/>
      </linearGradient>
    </defs>
    <ellipse cx="65" cy="190" rx="40" ry="7" fill="#01201c" opacity=".5"/>
    <path d="M40 60V48c0-7 5-12 12-12h13c8 0 13 6 13 13v11Z" fill="#a8bdb2"/>
    <path d="M28 96c0-11 6-18 15-24v-8h33v8c9 6 15 13 15 24v62c0 12-8 20-21 20H49c-13 0-21-8-21-20Z" fill="rgba(255,255,255,.14)" stroke="rgba(255,255,255,.35)" stroke-width="1.4"/>
    <rect x="31" y="112" width="66" height="60" rx="6" fill="url(#pl-bottle-{{ bottle_uid }})"/>
    <text x="64" y="140" text-anchor="middle" font-family="Outfit, sans-serif" font-size="8.6" font-weight="800" letter-spacing=".7" fill="#faf7fd">PURELANE</text>
    <line x1="42" y1="146" x2="86" y2="146" stroke="#f0a03c" stroke-width=".9" opacity=".85"/>
  </svg>
</span>
