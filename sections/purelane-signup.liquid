{% schema %}
{
  "name": "Purelane Signup",
  "tag": "section",
  "class": "purelane-signup-section",
  "settings": [
    {
      "type": "header",
      "content": "Purelane Signup",
      "info": "Purelane Signup"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Get ₹100 off your first bundle",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Plus first access to new launches and restocks.</p>",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "placeholder",
      "default": "your@email.com",
      "label": "Placeholder"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Get my ₹100 off",
      "label": "Button Label"
    }
  ],
  "presets": [
    {
      "name": "Purelane Signup Preset",
      "category": "Purelane Signup"
    }
  ]
}
{% endschema %}
{% stylesheet %}
{% endstylesheet %}
{% javascript %}
{% endjavascript %}
<div class="purelane-signup page-width">
  <div class="purelane-signup__wrapper">
    <div class="purelane-signup__content glass signup">
      <span class="purelane-signup__kicker">Join the Purelane Club</span>
      <h2 class="purelane-signup__heading">{{ section.settings.heading }}</h2>
      <p class="purelane-signup__lede">{{ section.settings.subheading }}</p>
      <form action="#" method="post" onsubmit="return false">
        <input type="email" placeholder="{{ section.settings.placeholder }}" aria-label="Email address" required>
        <button type="submit" class="purelane-signup__button btn btn-primary">{{ section.settings.button_label }}</button>
      </form>
    </div>
  </div>
</div>
