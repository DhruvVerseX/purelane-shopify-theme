<section id="proof" class="sec purelane-proof" data-section-id="{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
          <div class="body-s" style="max-width:40ch">{{ section.settings.body }}</div>
          {%- if section.settings.button_label != blank -%}
            <a class="btn btn-primary" href="{{ section.settings.button_link }}" style="margin-top:22px">
              {{ section.settings.button_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          {%- endif -%}
        </div>

        <div class="glass-2 rot" id="rot" aria-hidden="true">
          <div class="frame">
            {%- assign rotator_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'rotator_product' -%}
                {%- assign rotator_index = rotator_index | plus: 1 -%}
                {%- assign product = block.settings.product -%}
                <span
                  class="pimg {% if rotator_index == 1 %}on{% endif %}"
                  role="img"
                  aria-label="{{ block.settings.title | default: product.title | escape }}"
                  data-name="{{ block.settings.title | default: product.title | escape }}"
                  data-note="{{ block.settings.note | escape }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title }}
                  {%- elsif block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title }}
                  {%- else -%}
                    {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- assign first_rotator = section.blocks | where: 'type', 'rotator_product' | first -%}
          <div class="cap">
            <b>{{ first_rotator.settings.title | default: first_rotator.settings.product.title }}</b>
            <span>{{ first_rotator.settings.note }}</span>
          </div>
          <div class="dots">
            {%- assign dot_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'rotator_product' -%}
                {%- assign dot_index = dot_index | plus: 1 -%}
                <i class="{% if dot_index == 1 %}on{% endif %}"></i>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="stat" {{ block.shopify_attributes }}>
                <div class="ring">{{ block.settings.value }}</div>
                <h5>{{ block.settings.heading }}</h5>
                <p>{{ block.settings.body }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Proof",
  "tag": "section",
  "class": "purelane-proof-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tough on grime. Gentle on everything else." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the ingredient list" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "rotator_product",
      "name": "Rotator product",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "note", "label": "Caption", "default": "Foam lifts grease, no scrubbing" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "99.9%" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Germ kill" },
        { "type": "text", "id": "body", "label": "Body", "default": "Tested against germs and bacteria" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Proof",
      "blocks": [
        { "type": "rotator_product", "settings": { "title": "Kitchen cleaner", "note": "Foam lifts grease, no scrubbing" } },
        { "type": "rotator_product", "settings": { "title": "Tap & limescale", "note": "Melts hard water stains" } },
        { "type": "rotator_product", "settings": { "title": "Laundry detergent", "note": "Tough on odour, soft on fabric" } },
        { "type": "stat", "settings": { "value": "99.9%", "heading": "Germ kill", "body": "Tested against germs and bacteria" } },
        { "type": "stat", "settings": { "value": "0%", "heading": "Sulphates", "body": "No SLS, chlorine or parabens" } },
        { "type": "stat", "settings": { "value": "100%", "heading": "Plant based", "body": "Cleansers derived from plants" } },
        { "type": "stat", "settings": { "value": "4.8", "heading": "Rated", "body": "Across 8,000+ verified reviews" } }
      ]
    }
  ]
}
{% endschema %}
