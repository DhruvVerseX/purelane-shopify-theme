<!-- ================= STICKY CTA ================= -->
<div
  class="sticky"
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="sticky-cta"
>
  <span class="lbl">
    <b>{{ section.settings.heading | default: 'Pick any 3, pay ₹499' | escape }}</b>
    <span>{{ section.settings.subheading | default: 'Free shipping, always' | escape }}</span>
  </span>
  <a class="btn btn-primary btn-sm" href="{{ section.settings.button_link | default: '#bundles' }}">
    {{ section.settings.button_label | default: 'Build bundle' | escape }}
  </a>
</div>
{% schema %}
{
  "name": "Purelane Sticky CTA",
  "tag": "section",
  "class": "purelane-sticky-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick any 3, pay ₹499" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Free shipping, always" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Build bundle" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Purelane Sticky CTA" }]
}
{% endschema %}
