<header class="purelane-header" id="purelane-header">
  <div class="purelane-navpill glass">
    <a class="purelane-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      <span class="purelane-brand__mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="purelane-brand__txt">
        <span class="purelane-brand__n1">{{ shop.name }}</span>
        <span class="purelane-brand__n2">Clean, simply</span>
      </span>
    </a>
    <nav class="purelane-nav" aria-label="Main">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="#ingredients">Ingredients</a>
      <a href="#how">How it works</a>
      <a href="#shop">Shop</a>
      <a href="#bundles">Bundles</a>
    </nav>
    <div class="purelane-navtools">
      <a class="purelane-ico purelane-ico--hide-s" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a class="purelane-ico purelane-ico--hide-s" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
      </a>
      <a class="purelane-ico" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        {%- if cart.item_count > 0 -%}
          <span class="purelane-dot">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
      <button type="button" class="purelane-ico purelane-burger" aria-label="Menu" aria-expanded="false" data-purelane-menu-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <div class="purelane-mobile-menu" hidden data-purelane-mobile-menu>
    <a href="{{ routes.root_url }}">Home</a>
    <a href="#ingredients">Ingredients</a>
    <a href="#how">How it works</a>
    <a href="#shop">Shop</a>
    <a href="#bundles">Bundles</a>
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.account_url }}">Account</a>
  </div>
</header>
