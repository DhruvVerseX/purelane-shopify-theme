<!-- ================= NAV ================= -->
<header
  id="purelane-header-{{ section.id }}"
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="header-nav"
  data-purelane-header
>
  <div class="navpill glass">
    <a class="brand" href="{{ section.settings.brand_link | default: '#top' }}" aria-label="{{ section.settings.brand_label | default: 'Purelane home' | escape }}">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: 'Purelane' | escape }}</span>
        <span class="n2">{{ section.settings.tagline | default: 'Clean, simply' | escape }}</span>
      </span>
    </a>
    <nav class="nav" aria-label="{{ section.settings.nav_label | default: 'Main' | escape }}">
      <a href="{{ section.settings.link_1_url | default: '#top' }}">{{ section.settings.link_1_label | default: 'Home' | escape }}</a>
      <a href="{{ section.settings.link_2_url | default: '#ingredients' }}">{{ section.settings.link_2_label | default: 'Ingredients' | escape }}</a>
      <a href="{{ section.settings.link_3_url | default: '#how' }}">{{ section.settings.link_3_label | default: 'How it works' | escape }}</a>
      <a href="{{ section.settings.link_4_url | default: '#shop' }}">{{ section.settings.link_4_label | default: 'Shop' | escape }}</a>
      <a href="{{ section.settings.link_5_url | default: '#bundles' }}">{{ section.settings.link_5_label | default: 'Bundles' | escape }}</a>
    </nav>
    <div class="navtools">
      <a class="ico hide-s" href="{{ routes.search_url }}" aria-label="{{ section.settings.search_label | default: 'Search' | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
      <a class="ico hide-s" href="{{ routes.account_url }}" aria-label="{{ section.settings.account_label | default: 'Account' | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg></a>
      <a class="ico" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | default: 'Cart' | escape }}, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg><span class="dot">{{ cart.item_count }}</span></a>
      <button class="ico burger" type="button" aria-label="{{ section.settings.menu_label | default: 'Menu' | escape }}" aria-expanded="false" aria-controls="purelane-mobile-nav-{{ section.id }}" data-purelane-menu-toggle><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg></button>
    </div>
  </div>
  <nav class="mobile-nav glass" id="purelane-mobile-nav-{{ section.id }}" aria-label="{{ section.settings.mobile_nav_label | default: 'Mobile menu' | escape }}" data-purelane-mobile-menu>
    <a href="{{ section.settings.link_1_url | default: '#top' }}">{{ section.settings.link_1_label | default: 'Home' | escape }}</a>
    <a href="{{ section.settings.link_2_url | default: '#ingredients' }}">{{ section.settings.link_2_label | default: 'Ingredients' | escape }}</a>
    <a href="{{ section.settings.link_3_url | default: '#how' }}">{{ section.settings.link_3_label | default: 'How it works' | escape }}</a>
    <a href="{{ section.settings.link_4_url | default: '#shop' }}">{{ section.settings.link_4_label | default: 'Shop' | escape }}</a>
    <a href="{{ section.settings.link_5_url | default: '#bundles' }}">{{ section.settings.link_5_label | default: 'Bundles' | escape }}</a>
  </nav>
</header>
{% schema %}
{
  "name": "Purelane Header Nav",
  "tag": "section",
  "class": "purelane-header-nav-section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Purelane" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Clean, simply" },
    { "type": "url", "id": "brand_link", "label": "Brand link" },
    { "type": "text", "id": "brand_label", "label": "Brand accessibility label", "default": "Purelane home" },
    { "type": "text", "id": "nav_label", "label": "Navigation accessibility label", "default": "Main" },
    { "type": "text", "id": "link_1_label", "label": "Link 1 label", "default": "Home" },
    { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
    { "type": "text", "id": "link_2_label", "label": "Link 2 label", "default": "Ingredients" },
    { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
    { "type": "text", "id": "link_3_label", "label": "Link 3 label", "default": "How it works" },
    { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
    { "type": "text", "id": "link_4_label", "label": "Link 4 label", "default": "Shop" },
    { "type": "url", "id": "link_4_url", "label": "Link 4 URL" },
    { "type": "text", "id": "link_5_label", "label": "Link 5 label", "default": "Bundles" },
    { "type": "url", "id": "link_5_url", "label": "Link 5 URL" },
    { "type": "text", "id": "search_label", "label": "Search icon label", "default": "Search" },
    { "type": "text", "id": "account_label", "label": "Account icon label", "default": "Account" },
    { "type": "text", "id": "cart_label", "label": "Cart icon label", "default": "Cart" },
    { "type": "text", "id": "menu_label", "label": "Menu button label", "default": "Menu" },
    { "type": "text", "id": "mobile_nav_label", "label": "Mobile menu label", "default": "Mobile menu" }
  ],
  "presets": [{ "name": "Purelane Header Nav" }]
}
{% endschema %}
