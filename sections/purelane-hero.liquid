<!-- ================= HERO ================= -->
<section
  class="hero"
  id="purelane-hero-{{ section.id }}"
  data-purelane-section
  data-section-id="{{ section.id }}"
  data-section-type="hero"
  data-purelane-anchor="top"
  data-purelane-hero
  data-scene="1"
>
  <div class="hero-grid">

    <div class="badges glass-2" aria-label="{{ section.settings.badges_label | default: 'Product promises' | escape }}">
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
        <span>{{ section.settings.badge_1 | default: 'Plant<br>powered' }}</span>
      </div>
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg></span>
        <span>{{ section.settings.badge_2 | default: 'Safe for<br>kids &amp; pets' }}</span>
      </div>
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg></span>
        <span>{{ section.settings.badge_3 | default: 'Zero harsh<br>chemicals' }}</span>
      </div>
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading | default: 'Clean<br>That<br><span class="lime">Lasts</span>' }}</h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.body | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.' | escape }}</p>
      <div class="hero-cta rv rv-d3">
        <a class="btn btn-primary" href="{{ section.settings.primary_button_link | default: '#shop' }}">{{ section.settings.primary_button_label | default: 'Shop now' | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="{{ section.settings.secondary_button_link | default: '#how' }}">{{ section.settings.secondary_button_label | default: 'How it works' | escape }}</a>
      </div>

      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          {{ section.settings.strip_1 | default: 'Plant powered' | escape }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          {{ section.settings.strip_2 | default: 'Kids & pet safe' | escape }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
          {{ section.settings.strip_3 | default: 'Zero harsh chem' | escape }}
        </div>
      </div>
    </div>

    <div class="hero-prod" data-purelane-hero-product><div class="hstage" data-purelane-hero-stage><div class="hslide hs1 on" data-n="1" data-purelane-slide data-slide-index="0"><span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span><div class="glass-2 ptag"><span class="lbl">{{ section.settings.slide_1_label | default: 'Single bottle' | escape }}</span><span class="val"><strong>{{ section.settings.slide_1_price | default: '₹200' | escape }}</strong><s>{{ section.settings.slide_1_compare | default: '₹299' | escape }}</s></span><span class="cut">{{ section.settings.slide_1_badge | default: '33% off' | escape }}</span></div></div><div class="hslide hs2" data-n="2" data-purelane-slide data-slide-index="1"><span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span><span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span><div class="glass-2 ptag"><span class="lbl">{{ section.settings.slide_2_label | default: 'Any 2 products' | escape }}</span><span class="val"><strong>{{ section.settings.slide_2_price | default: '₹349' | escape }}</strong><s>{{ section.settings.slide_2_compare | default: '₹598' | escape }}</s></span><span class="cut">{{ section.settings.slide_2_badge | default: 'Save ₹249' | escape }}</span></div></div><div class="hslide hs3" data-n="3" data-purelane-slide data-slide-index="2"><span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span><span class="hp p-mbtl b d2" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span><span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span><div class="glass-2 ptag"><span class="lbl">{{ section.settings.slide_3_label | default: 'Any 3 products' | escape }}</span><span class="val"><strong>{{ section.settings.slide_3_price | default: '₹499' | escape }}</strong><s>{{ section.settings.slide_3_compare | default: '₹897' | escape }}</s></span><span class="cut">{{ section.settings.slide_3_badge | default: 'Save ₹398' | escape }}</span></div></div></div><div class="hdots" data-purelane-hero-dots><button type="button" class="on" aria-label="Show 1 product"></button><button type="button" class="" aria-label="Show 2 products"></button><button type="button" class="" aria-label="Show 3 products"></button></div></div>

  </div>
</section>
{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading", "default": "Clean<br>That<br><span class=\"lime\">Lasts</span>" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." },
    { "type": "text", "id": "primary_button_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "primary_button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "text", "id": "badges_label", "label": "Badges accessibility label", "default": "Product promises" },
    { "type": "html", "id": "badge_1", "label": "Badge 1", "default": "Plant<br>powered" },
    { "type": "html", "id": "badge_2", "label": "Badge 2", "default": "Safe for<br>kids &amp; pets" },
    { "type": "html", "id": "badge_3", "label": "Badge 3", "default": "Zero harsh<br>chemicals" },
    { "type": "text", "id": "strip_1", "label": "Trust strip 1", "default": "Plant powered" },
    { "type": "text", "id": "strip_2", "label": "Trust strip 2", "default": "Kids & pet safe" },
    { "type": "text", "id": "strip_3", "label": "Trust strip 3", "default": "Zero harsh chem" },
    { "type": "header", "content": "Slide 1" },
    { "type": "text", "id": "slide_1_label", "label": "Label", "default": "Single bottle" },
    { "type": "text", "id": "slide_1_price", "label": "Price", "default": "₹200" },
    { "type": "text", "id": "slide_1_compare", "label": "Compare price", "default": "₹299" },
    { "type": "text", "id": "slide_1_badge", "label": "Badge", "default": "33% off" },
    { "type": "header", "content": "Slide 2" },
    { "type": "text", "id": "slide_2_label", "label": "Label", "default": "Any 2 products" },
    { "type": "text", "id": "slide_2_price", "label": "Price", "default": "₹349" },
    { "type": "text", "id": "slide_2_compare", "label": "Compare price", "default": "₹598" },
    { "type": "text", "id": "slide_2_badge", "label": "Badge", "default": "Save ₹249" },
    { "type": "header", "content": "Slide 3" },
    { "type": "text", "id": "slide_3_label", "label": "Label", "default": "Any 3 products" },
    { "type": "text", "id": "slide_3_price", "label": "Price", "default": "₹499" },
    { "type": "text", "id": "slide_3_compare", "label": "Compare price", "default": "₹897" },
    { "type": "text", "id": "slide_3_badge", "label": "Badge", "default": "Save ₹398" }
  ],
  "presets": [{ "name": "Purelane Hero" }]
}
{% endschema %}
