<header class="purelane-header" data-purelane-section data-section-type="header-nav" data-purelane-header>
  <div class="purelane-navpill glass">
    <a class="purelane-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      <span class="purelane-brand__txt">
        <span class="purelane-brand__n1">pure<span>lane</span>.</span>
      </span>
    </a>
    <nav class="purelane-nav" aria-label="Main">
      <a href="#shop">Shop</a>
      <a href="#ingredients">Ingredients</a>
      <a href="#how">Why Purelane</a>
      <a href="#bundles">Bundles</a>
    </nav>
    <div class="purelane-navtools">
      <a class="purelane-ico purelane-ico--hide-s" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a class="purelane-bag" href="{{ routes.cart_url }}" aria-label="Bag, {{ cart.item_count }} items">
        <span>Bag</span>
        <span>{{ cart.item_count }}</span>
      </a>
      <button type="button" class="purelane-ico purelane-burger" aria-label="Menu" aria-expanded="false" aria-controls="purelane-mobile-menu-{{ section.id | default: 'snippet' }}" data-purelane-menu-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <div class="purelane-mobile-menu" id="purelane-mobile-menu-{{ section.id | default: 'snippet' }}" hidden data-purelane-mobile-menu>
    <a href="#shop">Shop</a>
    <a href="#ingredients">Ingredients</a>
    <a href="#how">Why Purelane</a>
    <a href="#bundles">Bundles</a>
    <a href="{{ routes.search_url }}">Search</a>
  </div>
</header>
