{% schema %}
{
  "name": "Purelane Proof",
  "tag": "section",
  "class": "purelane-proof-section",
  "settings": [
    {
      "type": "header",
      "content": "Purelane Proof"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Why it works",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Tough on grime.<br>Gentle on everything else.</p>",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "See the ingredient list",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "proof_product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "show_new_badge",
          "default": false,
          "label": "Show new badge"
        },
        {
          "type": "text",
          "id": "rating",
          "default": "4.8",
          "label": "Rating"
        },
        {
          "type": "text",
          "id": "review_count",
          "default": "231",
          "label": "Review count"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Proof",
      "category": "Purelane",
      "blocks": [
        {
          "type": "proof_product"
        },
        {
          "type": "proof_product"
        },
        {
          "type": "proof_product"
        }
      ]
    }
  ]
}
{% endschema %}
{% stylesheet %}
{% endstylesheet %}
{% javascript %}
{% endjavascript %}
<div class="purelane-proof page-width">
  <div class="purelane-proof__wrapper">
    {% if section.settings.heading != blank %}
    <div class="purelane-proof__header">
      <span class="purelane-proof__kicker">Why it works</span>
      <h2 class="purelane-proof__heading">{{ section.settings.heading }}</h2>
      {{ section.settings.subheading }}
    </div>
    {% endif %}
    <div class="purelane-proof__grid">
      {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% assign show_new_badge = block.settings.show_new_badge %}
      {% assign rating = block.settings.rating %}
      {% assign review_count = block.settings.review_count %}
      {% if product != blank %}
      <article class="purelane-proof__card glass" {{ block.shopify_attributes }}>
        <div class="purelane-proof__shot">
          {% if show_new_badge %}
            <span class="purelane-proof__badge">New</span>
          {% endif %}
          {% if product.featured_image != blank %}
            {{ product.featured_image | image_url: width: 300 | image_tag: width: 300, height: 300, alt: product.title }}
          {% else %}
            {{ 'icon' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <h4 class="purelane-proof__heading">{{ product.title }}</h4>
        <div class="purelane-proof__rating"><b>★ {{ rating }}</b> · {{ review_count }} reviews</div>
        <div class="purelane-proof__price">
          {% if product.compare_at_price > product.price %}
            {% assign price_diff = product.compare_at_price | minus: product.price %}
            {% assign discount_percent = price_diff | times: 100 | divided_by: product.compare_at_price | round %}
            <strong>{{ product.price | money }}</strong>{{ product.compare_at_price | money }}
            <em>{{ discount_percent }}% off</em>
          {% else %}
            <strong>{{ product.price | money }}</strong>
          {% endif %}
        </div>
        <button type="button" class="purelane-proof__button btn btn-ghost btn-sm">Add to cart</button>
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
