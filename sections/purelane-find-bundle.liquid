<section id="categories" class="sec purelane-find-bundle" data-section-id="{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#combos' }}" class="glass cat rv {% if forloop.index == 2 %}rv-d1{% elsif forloop.index == 3 %}rv-d2{% elsif forloop.index == 4 %}rv-d3{% endif %}" {{ block.shopify_attributes }}>
          <span class="ph">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.heading, class: 'pimg' }}
            {%- elsif block.settings.product.featured_image -%}
              <span class="pimg">{{ block.settings.product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.heading }}</span>
            {%- else -%}
              <span class="pimg">{{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
            {%- endif -%}
          </span>
          <span class="txt">
            <h4>{{ block.settings.heading }}</h4>
            <p>{{ block.settings.body }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Find Bundle",
  "tag": "section",
  "class": "purelane-find-bundle-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right bundle for you" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "product", "id": "product", "label": "Product preview" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Kitchen bundle" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Grease, dishes & more" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Find Bundle", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
