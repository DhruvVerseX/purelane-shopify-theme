<section id="reviews" class="sec revband purelane-reviews" data-section-id="{{ section.id }}" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg">
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <b>{{ section.settings.rating_text }}</b> from {{ section.settings.review_count }} reviews
      </span>
      <span class="agg">Loved by <b>{{ section.settings.homes_count }}</b> homes</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">
              {%- for star in (1..block.settings.rating) -%}&#9733;{%- endfor -%}
            </div>
            <h5>{{ block.settings.heading }}</h5>
            <p>{{ block.settings.body }}</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>{{ block.settings.reviewer_name }}</b>
              <span>&middot; {{ block.settings.reviewer_location }}</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating_text", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "8,000+" },
    { "type": "text", "id": "homes_count", "label": "Homes count", "default": "12 lakh+" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 10,
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Rating" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Works like a charm" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Anita" },
        { "type": "text", "id": "reviewer_location", "label": "Product", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane Reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
